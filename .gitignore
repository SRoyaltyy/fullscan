__pycache__/
*.pyc
*.pyo
.env
*.egg-info/
dist/
build/
.venv/
venv/

# Loader / one-shot AI restore leftovers (do not commit)
src/_ab_checklist_cached.py
src/_ab_backfill.b64*
src/_ab_src.*
*.b64
scripts/_patch_*.b64
scripts/FORCE_AB_BACKFILL_*

# Runtime secrets written by experimental harvest/catcher scripts
service_account.json
gemini_browser_state.json
*_browser_state.json

# ---------------------------------------------------------------------------
# Generated blobs — stop the git data lake from growing.
# Already-tracked copies are left in the tree (no history rewrite, no delete).
# Workflows MUST NOT `git add` these paths; `git add -A` jobs run
# scripts/unstage_growth_blobs.sh after staging.
# ---------------------------------------------------------------------------

# Raw LLM JSON dumps (hundreds of files). Keep dated *.md under 01_daily/.
01_daily/_transcripts/

# Local OHLC store (~75MB). Regenerated by `python -m src.price_store`.
# Keep data/prices/meta.json tracked.
data/prices/ohlc.parquet
data/prices/*.parquet

# Dated Finviz Elite dumps (~11MB/day). Rolling snapshot: data/finviz/latest.csv
# Postgres already stores the same rows. Keep data/exports/finviz_headers.txt.
data/exports/finviz_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].csv

# Dated CSVs. Live stock-book / AB / insider jobs force-add the ones they publish.
data/join/*.csv
data/universe/*_membership.csv
data/universe/*_segment_stats.csv
data/insider/**
data/checklist/**
data/ab_checklist/**
data/ab_backfill/**
