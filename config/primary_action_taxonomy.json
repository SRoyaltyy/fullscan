{
  "version": "primary-action-taxonomy-v1",
  "scope": "Coverage planning taxonomy, not a semantic classifier. Lane inference remains downstream. Preserve originating issuer, native ID, publication stage and source date.",
  "families": [
    {
      "name": "Executive instruments",
      "types": [
        "Executive orders",
        "Proclamations",
        "Decrees",
        "Cabinet decisions",
        "Ministerial orders"
      ],
      "originating_institutions": [
        "Presidency",
        "Cabinet",
        "Executive office",
        "Ministries"
      ],
      "preferred_channel": "Signed-action register or official gazette"
    },
    {
      "name": "Legislation",
      "types": [
        "Introduction",
        "Committee action",
        "Passage",
        "Enrolment",
        "Assent",
        "Veto",
        "Repeal",
        "Commencement"
      ],
      "originating_institutions": [
        "Legislatures",
        "Committees",
        "Heads of state"
      ],
      "preferred_channel": "Bill action feed and laws portal; preserve procedural stage"
    },
    {
      "name": "Regulation and standards",
      "types": [
        "Proposed rules",
        "Final rules",
        "Emergency rules",
        "Amendments",
        "Binding standards",
        "Interpretive guidance",
        "Consultation outcome"
      ],
      "originating_institutions": [
        "Regulators",
        "Ministries",
        "Standards bodies"
      ],
      "preferred_channel": "Official rulemaking API, gazette or decision register"
    },
    {
      "name": "Sanctions and trade",
      "types": [
        "Designation",
        "Delisting",
        "Asset freeze",
        "Export restriction",
        "Import restriction",
        "Tariff change",
        "Trade remedy",
        "Quota",
        "General licence"
      ],
      "originating_institutions": [
        "Treasury",
        "Foreign affairs",
        "Commerce",
        "Customs",
        "Trade commissions"
      ],
      "preferred_channel": "Sanctions recent actions and trade-remedy decisions"
    },
    {
      "name": "Tax and public finance",
      "types": [
        "Tax changes",
        "Budget adoption",
        "Appropriation",
        "Public borrowing",
        "Subsidy award",
        "Grant award",
        "Funding withdrawal"
      ],
      "originating_institutions": [
        "Finance ministries",
        "Tax authorities",
        "Spending departments"
      ],
      "preferred_channel": "Tax decisions, appropriation records and award databases; opportunities are not awards"
    },
    {
      "name": "Monetary and financial operations",
      "types": [
        "Policy rate decision",
        "Reserve requirement",
        "Asset purchase",
        "Liquidity facility",
        "FX intervention",
        "Bank resolution",
        "Deposit guarantee"
      ],
      "originating_institutions": [
        "Central banks",
        "Deposit insurers",
        "Resolution authorities"
      ],
      "preferred_channel": "Policy decisions and operations announcements; reference quotes and statistics are not decisions"
    },
    {
      "name": "Judicial decisions",
      "types": [
        "Judgment",
        "Opinion",
        "Order",
        "Injunction",
        "Stay",
        "Dismissal",
        "Sentence",
        "Appeal disposition",
        "Judicial review"
      ],
      "originating_institutions": [
        "Supreme courts",
        "Appellate courts",
        "Trial courts",
        "Tribunals"
      ],
      "preferred_channel": "Official opinion/order feeds; publication date may differ from decision date"
    },
    {
      "name": "Enforcement",
      "types": [
        "Complaint",
        "Investigation",
        "Charge",
        "Administrative order",
        "Fine",
        "Settlement",
        "Consent decree",
        "Debarment",
        "Cease-and-desist"
      ],
      "originating_institutions": [
        "Regulators",
        "Prosecutors",
        "Inspectorates",
        "Enforcement agencies"
      ],
      "preferred_channel": "Enforcement register; allegations and final dispositions remain distinct"
    },
    {
      "name": "Competition and corporate permissions",
      "types": [
        "Merger clearance",
        "Conditional clearance",
        "Prohibition",
        "Antitrust order",
        "State-aid decision",
        "Foreign investment decision"
      ],
      "originating_institutions": [
        "Competition authorities",
        "Investment review bodies"
      ],
      "preferred_channel": "Case decision database; notification is not approval"
    },
    {
      "name": "Licences and safety",
      "types": [
        "Authorisation",
        "Licence grant",
        "Suspension",
        "Revocation",
        "Drug approval",
        "Permit decision",
        "Product recall",
        "Safety directive"
      ],
      "originating_institutions": [
        "Sector regulators",
        "Medicines agencies",
        "Transport authorities",
        "Environmental agencies"
      ],
      "preferred_channel": "Approval/licence/recall register"
    },
    {
      "name": "Procurement and infrastructure",
      "types": [
        "Tender publication",
        "Contract award",
        "Cancellation",
        "Concession award",
        "Land acquisition",
        "Planning approval"
      ],
      "originating_institutions": [
        "Procurement agencies",
        "Infrastructure ministries",
        "Planning bodies"
      ],
      "preferred_channel": "Contract and planning decision portals; tender is not award"
    },
    {
      "name": "Emergency and public services",
      "types": [
        "Disaster declaration",
        "Emergency order",
        "Health restriction",
        "Evacuation",
        "Eligibility change",
        "Benefit payment decision"
      ],
      "originating_institutions": [
        "Emergency agencies",
        "Health departments",
        "Service ministries"
      ],
      "preferred_channel": "Declaration/order index"
    },
    {
      "name": "Appointments and international actions",
      "types": [
        "Appointment",
        "Removal",
        "Election certification",
        "Treaty signature",
        "Ratification",
        "Resolution",
        "Public financing approval"
      ],
      "originating_institutions": [
        "Executive offices",
        "Election commissions",
        "Foreign ministries",
        "Intergovernmental bodies"
      ],
      "preferred_channel": "Appointment, treaty, resolution or board-decision register; intentions and speeches excluded"
    }
  ]
}
