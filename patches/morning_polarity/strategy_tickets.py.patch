+def _tag_polarity(rows: list[dict], default_side: str) -> list[dict]:
+    out = []
+    for row in rows:
+        item = dict(row)
+        side = str(item.get("kid_side") or item.get("side") or default_side or "long").lower()
+        if side not in ("long", "short"):
+            side = "long"
+        item["side"] = side
+        item["predict"] = "DOWN" if side == "short" else "UP"
+        out.append(item)
+    return out
+
