[Unit]
Description=fullscan: xAI OAuth renew every 5h + guaranteed 05:30 ET pre-Pre-Open check

[Timer]
# Every 5h (ahead of the ~6h xAI token life).
OnCalendar=*-*-* 00,05,10,15,20:10:00 America/New_York
# 04:10 ET renews a token that died after the 20:10 slot, before
# Pre-Open. 05:30 is the last check. The GitHub cron is 04:40 so it
# does not restart the gateway at the same minute as this timer.
OnCalendar=Mon..Fri *-*-* 04:10:00 America/New_York
OnCalendar=Mon..Fri *-*-* 05:30:00 America/New_York
Persistent=true
AccuracySec=30s
Unit=fullscan-openclaw-oauth.service

[Install]
WantedBy=timers.target
