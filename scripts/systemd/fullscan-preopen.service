[Unit]
Description=fullscan Pre-Open ALL (ECS clock, not GitHub)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gha
Group=gha
WorkingDirectory=/home/gha/fullscan
EnvironmentFile=-/home/gha/.fullscan.env
Environment=TZ=America/New_York
Environment=OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
Environment=OPENCLAW_TIMEOUT=10800
Environment=FULLSCAN_HOME=/home/gha
Environment=PYTHONUNBUFFERED=1
# Invoke via bash: git tracks these scripts as 100644, and
# `git reset --hard origin/main` would drop +x. bash does not care.
# + prefix: run as root so we can patch ~/.openclaw JSON *and* bounce the
# gateway. User=gha cannot systemctl restart openclaw.
ExecStartPre=+/bin/bash /home/gha/fullscan/scripts/ensure_openclaw_timeouts.sh
ExecStart=/bin/bash /home/gha/fullscan/scripts/ecs_preopen.sh
Nice=5
TimeoutStartSec=21600
StandardOutput=append:/home/gha/fullscan-logs/preopen.log
StandardError=append:/home/gha/fullscan-logs/preopen.log

[Install]
WantedBy=multi-user.target
