# Copy to /home/gha/.fullscan.env and chmod 600.
# GitHub is NOT involved in starting the job. These are local env vars.

# Grok via OpenClaw on THIS box (loopback — do not use the public IP)
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_TOKEN=
OPENCLAW_TIMEOUT=10800
OPENCLAW_AGENT=openclaw/default
OPENCLAW_BACKEND_MODEL=xai/grok-4.6

# DeepSeek = fallback only
DEEPSEEK_API_KEY=

# Push artifacts to GitHub (store, not clock). PAT with contents:write.
GITHUB_TOKEN=

# Data
DATABASE_URL=
DATABASE_KEY=
FRED_API_KEY=
SEARXNG_URL=

# Finviz (digest)
FINVIZ_EMAIL=
FINVIZ_PASSWORD=
FINVIZ_EXPORT=
FINVIZ_AUTH=
AUTH_TOKEN_FINVIZ=
